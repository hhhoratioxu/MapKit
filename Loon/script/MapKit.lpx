#!name = MapKit
#!desc = iOS & iPadOS & macOS\n1.自定义地图地区与服务\n2.选择 2D 和 3D 卫星图源\n3.选择导航、路况与兴趣点数据\n4.选择 Flyover 与四处看看图源
#!author = VirgilClyne[https://github.com/VirgilClyne],hhhoratioxu[https://github.com/hhhoratioxu]
#!homepage = https://github.com/hhhoratioxu/MapKit
#!icon = https://developer.apple.com/assets/elements/icons/maps/maps-128x128.png
#!tag =  iRingo
#!system = iOS,iPadOS,macOS
#!date = 2026-11-14 23:34:17
#!version = 4.6.2
#!system_version = 15
#!loon_version = 3.5.1(983)

[Argument]
CountryCode = select,"US","AUTO","CN","HK","TW","SG","JP","AU","GB","KR","CA","IE",type=string,tag=清单地区,desc=AUTO 保留 Apple 请求地区；KR 不包含独立韩国瓦片合成
Environment = select,"AUTO","CN","XX",type=string,tag=公告环境
Dispatcher = select,"AutoNavi","Apple","AUTO",type=string,tag=地点服务
Directions = select,"AutoNavi","Apple","AUTO",type=string,tag=导航与 ETA
RAP = select,"Apple","AutoNavi","AUTO",type=string,tag=评分和照片
LocationShift = select,"AUTO","AutoNavi","Apple",type=string,tag=定位服务,desc=AUTO 沿用上游规则：watchOS 采用 Apple；其他系统采用高德
Map = select,"CN","XX",type=string,tag=地图,desc=CN 中国版；XX 国际版
Satellite2D = select,"CN","XX",type=string,tag=2D 卫星,desc=CN 中国版；XX 国际版
Satellite3D = select,"XX","CN",type=string,tag=3D 卫星,desc=CN 中国版；XX 国际版
Traffic = select,"CN","XX",type=string,tag=交通,desc=CN 中国版；XX 国际版
POI = select,"CN","XX",type=string,tag=兴趣点,desc=CN 中国版；XX 国际版
Flyover = select,"XX","CN",type=string,tag=俯瞰,desc=CN 中国版；XX 国际版
Munin = select,"XX","CN",type=string,tag=四处看看,desc=CN 中国版；XX 国际版
Road = select,"CN","XX",type=string,tag=道路,desc=CN 中国版；XX 国际版
Earth = select,"CN","XX",type=string,tag=地球,desc=CN 中国版；XX 国际版
Transit = select,"CN","XX",type=string,tag=公共交通,desc=CN 中国版；XX 国际版

[Rewrite]
request if ${url} ~= /^https:\/\/configuration\.ls\.apple\.com\/config\/defaults(?:\?|$)/ then request.header.del(["If-None-Match", "If-Modified-Since"])
request if ${url} ~= /^https:\/\/gspe35-ssl\.ls\.apple\.(?:com|cn)\/geo_manifest\/dynamic\/config(?:\?|$)/ then request.header.del(["If-None-Match", "If-Modified-Since"])

[Script]
request if ${url} ~= /^https:\/\/gspe35-ssl\.ls\.apple\.(?:com|cn)\/geo_manifest\/dynamic\/config(?:\?|$)/ && ${request.method} == "GET" then script("https://raw.githubusercontent.com/hhhoratioxu/MapKit/stability-v1/Loon/script/request.bundle.js", {${CountryCode}, ${Environment}, ${Dispatcher}, ${Directions}, ${RAP}, ${LocationShift}, ${Map}, ${Satellite2D}, ${Satellite3D}, ${Traffic}, ${POI}, ${Flyover}, ${Munin}, ${Road}, ${Earth}, ${Transit}}) with timeout=8, tag="MapKit manifest request"
request if ${url} ~= /^https:\/\/gspe35-ssl\.ls\.apple\.(?:com|cn)\/config\/announcements(?:\?|$)/ && ${request.method} == "GET" then script("https://raw.githubusercontent.com/hhhoratioxu/MapKit/stability-v1/Loon/script/request.bundle.js", {${CountryCode}, ${Environment}, ${Dispatcher}, ${Directions}, ${RAP}, ${LocationShift}, ${Map}, ${Satellite2D}, ${Satellite3D}, ${Traffic}, ${POI}, ${Flyover}, ${Munin}, ${Road}, ${Earth}, ${Transit}}) with timeout=8, tag="MapKit announcements"
response if ${url} ~= /^https:\/\/gspe35-ssl\.ls\.apple\.(?:com|cn)\/geo_manifest\/dynamic\/config(?:\?|$)/ && ${request.method} == "GET" && ${response.status} == 200 then script("https://raw.githubusercontent.com/hhhoratioxu/MapKit/stability-v1/Loon/script/response.bundle.js", {${CountryCode}, ${Environment}, ${Dispatcher}, ${Directions}, ${RAP}, ${LocationShift}, ${Map}, ${Satellite2D}, ${Satellite3D}, ${Traffic}, ${POI}, ${Flyover}, ${Munin}, ${Road}, ${Earth}, ${Transit}}) with requires_body=true, binary_body_mode=true, timeout=8, tag="MapKit manifest response"
response if ${url} ~= /^https:\/\/configuration\.ls\.apple\.com\/config\/defaults(?:\?|$)/ && ${request.method} == "GET" && ${response.status} == 200 then script("https://raw.githubusercontent.com/hhhoratioxu/MapKit/stability-v1/Loon/script/defaults.bundle.js") with requires_body=true, timeout=5, tag="MapKit defaults"

[MITM]
hostname = configuration.ls.apple.com, gspe35-ssl.ls.apple.com, gspe35-ssl.ls.apple.cn
